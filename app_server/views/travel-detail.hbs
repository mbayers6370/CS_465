<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html lang="en">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta charset="UTF-8">
	<title>{{title}}</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
	<link rel="icon" type="image/png" href="/images/Bird_Oragami.png">
</head>
<body>
	<div id="background">
		<div id="page">
			<div id="header">
				<div id="logo">
					<a href="/index.html"><img class="logo-full" src="/images/logo.png" alt="Travlr Getaways" height="200" width="200"><img class="logo-bird" src="/images/Bird_Oragami.png" alt="Travlr Getaways" height="200" width="200"><span class="logo-wordmark"><span class="logo-brand">Travlr</span><span class="logo-subbrand">getaways</span></span></a>
				</div>
				<div id="navigation">
					<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
						<span class="nav-toggle-icon" aria-hidden="true">
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
						</span>
						<span class="nav-toggle-label">Menu</span>
					</button>
					<ul id="primary-navigation">
						<li>
							<a href="/index.html">Home</a>
						</li>
						<li class="selected">
							<a href="/travel">Travel</a>
						</li>
						<li>
							<a href="/rooms.html">Rooms</a>
						</li>
						<li>
							<a href="/meals.html">Meals</a>
						</li>
						<li>
							<a href="/news.html">News</a>
						</li>
						<li>
							<a href="/about.html">About</a>
						</li>
						<li>
							<a href="/contact.html">Contact</a>
						</li>
					</ul>
				</div>
			</div>
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							{{#if message}}
							<div class="travel-detail-message">
								<h1>Travel</h1>
								<p>{{message}}</p>
								<a href="/travel">Back to Travel</a>
							</div>
							{{/if}}
							{{#if trip}}
							<article class="travel-detail">
								<a class="travel-back" href="/travel">Back to Travel</a>
								<img class="travel-detail-image" src="/images/{{trip.image}}" alt="{{trip.name}}">
								<div class="travel-detail-content">
									<div>
										<p class="travel-detail-code">{{trip.code}}</p>
										<h1>{{trip.name}}</h1>
									</div>
									<div class="travel-detail-meta">
										<p><span>Length</span>{{trip.length}}</p>
										<p><span>Starts</span>{{trip.startDate}}</p>
										<p><span>Resort</span>{{trip.resort}}</p>
										<p><span>Rate</span>{{trip.perPerson}}</p>
									</div>
									<div class="travel-detail-description">
										{{{trip.description}}}
									</div>
								</div>
							</article>
							{{/if}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
	<script src="/js/navigation.js"></script>
</body>
</html>
